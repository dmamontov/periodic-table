{
  "name": "periodic-table",
  "private": true,
  "version": "1.17.1",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "bin": {
    "periodic-table": "./cli/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsx cli/index.ts sitemap && vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint",
    "cli": "tsx cli/index.ts",
    "data:spectrum:convert": "tsx cli/index.ts spectrum",
    "data:collection:edit": "tsx cli/index.ts collection"
  },
  "dependencies": {
    "@fontsource/pt-sans": "5.2.8",
    "@svg-maps/world": "2.0.0",
    "@unhead/vue": "3.3.1",
    "vue": "3.5.38",
    "vue-router": "4.6.4",
    "vue-svg-map": "2.0.0-beta.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@clack/prompts": "1.7.0",
    "@eslint/js": "9.39.4",
    "@types/node": "24.13.2",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/tsconfig": "0.9.1",
    "commander": "15.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-node": "0.4.0",
    "eslint-plugin-file-progress": "3.0.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-package-json-dependencies": "1.0.20",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-vue": "10.9.2",
    "fast-xml-parser": "5.10.1",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "unplugin-fonts": "2.0.0",
    "vite": "8.0.16",
    "vite-plugin-pwa": "1.3.0",
    "vue-tsc": "3.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["unrs-resolver"]
  }
}
